#include <Servo.h>

// C++ code
//

Servo servo;
int s = 12;
int foto = A0;

void setup()
{
  pinMode(foto, INPUT);
  servo.attach(s);
  Serial.begin(9600); 
}

void loop()
{
  int luz = analogRead(foto);
  Serial.println(luz);
  
  if(luz > 380){
  servo.write(180);
  }
  else if(luz > 510){
  servo.write(150);
    delay(120);
  }
 
}
